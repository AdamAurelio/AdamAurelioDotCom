# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
# Every value below already has a sensible default in variables.tf — you can
# delete any line you don't need to override.

domain_name = "adamaurelio.com"
bucket_name = "adamaurelio-com-prod"
aws_region  = "us-east-1"

github_repo   = "AdamAurelio/AdamAurelioDotCom"
github_branch = "main"

# CloudFront edge coverage. PriceClass_100 = NA + Europe (cheapest).
# Use "PriceClass_All" for full global coverage.
price_class = "PriceClass_100"

# Set false if a GitHub OIDC provider already exists in this AWS account
# (only one is allowed per account), and supply its ARN:
# create_oidc_provider       = false
# existing_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Set true to have Terraform write the repo's Actions secret/variables for you.
# Requires a GITHUB_TOKEN (repo scope) in the environment when you apply.
# manage_github_actions_config = true

# ── Monitoring (monitoring.tf) ───────────────────────────────────────────────
# Off by default: monitoring.tf applies nothing until this is true. None of it
# bills at this scale (first 2 budgets free, alarms within CloudWatch's 10-alarm
# free tier, 1,000 SNS emails/month free) — it is opt-in only so the account
# stays empty until you want the alerts.
# enable_monitoring = true

# Address subscribed to the alerts topic. AWS emails a confirmation link — until
# it is clicked, alerts are created but silently discarded.
# alert_email = "you@example.com"

# Alarm thresholds and the monthly cost guardrail. Defaults: 1% / 25% / $5.
# cloudfront_5xx_threshold_percent = 1
# cloudfront_4xx_threshold_percent = 25
# monthly_budget_usd               = 5

# ── Google Search Console (dns.tf) ───────────────────────────────────────────
# TXT token from Search Console's Domain verification, value only (no
# "google-site-verification=" prefix). Empty skips the record entirely.
# google_site_verification = "abc123def456..."
